{
  "name": "levelia-game",
  "version": "0.1.0",
  "private": true,
  "description": "Discord panel games for LEVELIA",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && node --test test/*.test.js",
    "migrate": "node dist/migrate.js",
    "panel:install": "node dist/installPanel.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.3",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
