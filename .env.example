# Set the URL for the intended MySQL database. The Activity reads and updates accounts.wallet for wagers and payouts.
MYSQL_URL=
# Alternatively use Railway's individual MySQL variables:
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQL_DATABASE=
# Match this value to Railway's domain target port.
PORT=3000
# Client ID is public; keep the Client Secret server-side.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Slash commands: this app's public key (Developer Portal), guild, and its own bot token for registration only.
DISCORD_PUBLIC_KEY=
GUILD_ID=1534636292153807039
DISCORD_BOT_TOKEN=
# Private by default. Empty allowed IDs deny all players. Set public explicitly only when releasing.
ACTIVITY_ACCESS_MODE=private
ACTIVITY_ALLOWED_USER_IDS=

# real: 実残高 / virtual: 許可されたテスト参加者の専用仮想残高
# virtualはprivateと非空のACTIVITY_ALLOWED_USER_IDSが必須。
HIGH_LOW_WALLET_MODE=real
# Optional ranking-only cutover (ISO timestamp with timezone). Never deletes game history.
HIGH_LOW_LEADERBOARD_RESET_AT=
