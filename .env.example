# Set the URL for the intended MySQL database. The Activity reads and updates accounts.wallet for wagers and payouts.
MYSQL_URL=
# Alternatively use Railway's individual MySQL variables:
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQL_DATABASE=
# Match this value to Railway's domain target port.
PORT=3000
# Client ID is public; keep the Client Secret server-side.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
