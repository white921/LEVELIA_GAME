# Secrets: use a dedicated Discord application for LEVELIA_GAME.
DISCORD_TOKEN=
# Set the URL for the intended MySQL database. Do not reuse production secrets by default.
MYSQL_URL=
# Alternatively use Railway's individual MySQL variables:
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQL_DATABASE=
# Operational setting: target Discord server ID (Railway Variables in production).
GUILD_ID=
# unavailable or lia (read-only accounts.wallet integration)
BALANCE_MODE=unavailable
